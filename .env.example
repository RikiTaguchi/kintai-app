# データベース接続情報
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=kintai_app
DB_PORT=5432

# SQL 初期化 (本番初回は一度 only always→ 起動後 never に)
SQL_INIT_MODE=never

# Cookie 属性 (HTTPS 運用時は true)
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# フロントエンド -> バックエンド rewrite 先（docker-compose 内部通信用）
API_BASE_URL=http://api:8080
